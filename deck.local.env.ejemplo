# Datos de TU Steam Deck para las pruebas de integracion.
#
# Copia este fichero a deck.local.env y rellena lo tuyo. deck.local.env esta en
# .gitignore: este repositorio es publico y ni la IP de tu red ni tus
# contrasenas tienen por que acabar en el historial de git.
#
# Con el fichero puesto basta con ./test.sh — sin argumentos — para que corran
# tambien las pruebas contra la Deck.

# IP de la Deck en tu red y contrasena del usuario deck.
DECKMAN_TEST_HOST=192.168.1.50
DECKMAN_TEST_PASS=

# Clave de la API de SteamGridDB (https://www.steamgriddb.com/profile/preferences/api).
# Sin ella, las pruebas de caratulas se saltan solas.
DECKMAN_TEST_GRIDKEY=
