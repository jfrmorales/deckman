// Configuracion de Renovate, que abre pull requests cuando una dependencia se
// queda atras.
//
// Aqui NO hay workflow que lo lance, y no es un olvido: Renovate corre en el
// host, fuera del runner, disparado desde el repositorio de la infraestructura
// (`scripts/renovate-run.sh`, que lleva este repositorio en su lista). Tiene
// que ser asi porque Renovate necesita a la vez llegar a Forgejo por la red
// interna y tener salida a internet para consultar las versiones, y un
// contenedor del runner no tiene las dos cosas. Ese camino ya estaba montado y
// probado antes de que existiera este fichero; duplicarlo aqui solo habria
// dado un trabajo que falla cada dia.
//
// Lo que si vive aqui es la configuracion, porque Renovate la lee del propio
// repositorio que revisa.
//
// En .json5 y no .json a proposito: Renovate lee los dos, y sin comentarios
// esto acaba siendo una lista de reglas que nadie sabe por que dice lo que
// dice. Es el mismo criterio que en el resto del repositorio.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['local>jfrmorales/homelab//renovate-presets/base-ci'],

  timezone: 'Europe/Madrid',
  labels: ['dependencias'],

  // Politica comun del homelab (renovate-presets/base-ci): fixes de seguridad
  // inmediatos y agrupacion. EL AUTOMERGE DEL PRESET SE APAGA AQUI A PROPOSITO
  // (primera regla de packageRules): ver el comentario siguiente.
  //
  // Nada se fusiona solo. Este binario habla por SSH con la Deck de alguien y
  // borra ficheros suyos: una dependencia entra cuando el CI ha pasado Y
  // alguien la ha mirado, no porque los tests esten verdes.
  automerge: false,

  // Un aviso de seguridad no espera al lunes.
  vulnerabilityAlerts: {
    enabled: true,
    schedule: ['at any time'],
    labels: ['dependencias', 'seguridad'],
    // Tampoco los fixes de seguridad se fusionan solos aqui (el preset si los automergea).
    automerge: false,
  },

  // Tres PR abiertos como mucho: mas que eso deja de leerse.
  prConcurrentLimit: 3,
  prHourlyLimit: 2,

  // scripts/contenedor.sh clava la imagen de Go para el PC (GO_IMAGE) y
  // ningun gestor de Renovate lee un .sh. Sin esto, ese era el sitio que se
  // quedaba atras cuando subian los workflows.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/contenedor\\.sh$/'],
      matchStrings: ['GO_IMAGE="(?<depName>[^:"]+):(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    {
      // Anula el automerge del preset. Va en un packageRule y no en el nivel raiz
      // porque las reglas del preset ganan al `automerge: false` de arriba.
      // 'replacement' tambien: el preset lo automergea desde el 2026-11-16.
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest', 'replacement'],
      automerge: false,
    },
    {
      // Las x/... de Go se publican a la vez y se pisan entre ellas: subir
      // x/crypto sin x/sys deja un go.sum que el CI tiene que resolver solo.
      // Agrupadas son un PR que se mira una vez, en vez de cuatro que se
      // ignoran.
      matchPackageNames: ['golang.org/x/**'],
      groupName: 'bibliotecas x de Go',
    },
    {
      // La version de Go esta clavada en cuatro sitios (la directiva `go` de
      // go.mod, las imagenes de los tres workflows y GO_IMAGE en
      // scripts/contenedor.sh) y un paso del CI comprueba que no se separen.
      // Un PR que toque solo uno falla siempre, y subir Go ademas obliga a
      // subir las herramientas de auditoria. Por eso antes se hacia a mano; ahora
      // los cuatro se mueven juntos en un solo PR, que se mira una vez.
      // `go` es el nombre de la dependencia en go.mod (datasource
      // golang-version) y la imagen se llama como en los workflows.
      matchPackageNames: ['go', 'docker.io/library/golang'],
      groupName: 'toolchain de Go',
      // Sin `bump`, Renovate deja la directiva `go` de go.mod como esta
      // mientras la version nueva la siga cumpliendo, y solo sube las
      // imagenes: el paso «version de go» del CI falla siempre (PR de Go
      // 1.27.4, 2026-11-11). Solo afecta a `go`; en una imagen de docker con
      // la version clavada no cambia nada.
      rangeStrategy: 'bump',
      // Lo que NO se mueve solo: la version de golangci-lint en
      // scripts/contenedor.sh. Si el PR de Go falla en la auditoria, falta
      // subirla a mano a una que soporte esa version de Go.
    },
  ],
}
